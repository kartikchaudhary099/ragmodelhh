# ThinkZen Environment Configuration
# Copy this file to .env and fill in values as needed.
# Do NOT commit .env to version control.

# Application
APP_NAME=ThinkZen
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Optional API keys. All are OFF by default: with none set, the app runs fully
# on its dependency-free paths (deterministic grounded generation + honest
# "STT not configured" response). Uncomment and fill only what you want to
# enable. These are the exact variable names the code reads. Never commit real
# keys — set them in a local .env (which is git-ignored).
# ---------------------------------------------------------------------------

# Grounded generation via an external LLM. If either key is set, GroundedGenerator
# uses it; otherwise it falls back to the deterministic evidence-quoting synthesizer.
# GEMINI_API_KEY tried first, then OPENAI_API_KEY (see modules/generation/grounded_generator.py).
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Server-side speech-to-text (optional). The PRIMARY voice path is the browser
# Web Speech API and needs no key. Setting SARVAM_API_KEY enables the optional
# POST /api/v1/stt endpoint to make a real Sarvam AI call (see app/api/routes/stt.py).
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2

# Persistent vector database (optional / future). Not required for the default
# dependency-free run, which uses in-memory sparse + dense stores.
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=

# Data paths (relative to project root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLES_DIR=data/samples
